{
  "name": "@cosmotech/superset-viz-plugins",
  "version": "0.0.1",
  "description": "Monorepo de plugins de visualisation custom pour Apache Superset",
  "private": true,
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:dev": "lerna run build:dev",
    "clean": "lerna run clean",
    "test": "lerna run test",
    "test:watch": "lerna run test:watch",
    "lint": "lerna run lint",
    "lint:root": "eslint . --ext .ts,.tsx,.js --ignore-path .eslintignore",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "plugin:init": "node scripts/initPlugin.js",
    "plugin:pipeline": "node scripts/plugin_pipeline.js",
    "plugin:thumbnail": "node scripts/generate_thumbnail.js",
    "plugin:package": "node scripts/package_plugin.js",
    "plugins:package": "node scripts/package_plugins.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^29.7.0",
    "eslint": "^7.17.0",
    "eslint-plugin-react": "^7.20.6",
    "eslint-plugin-react-hooks": "^4.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^9.0.0",
    "prettier": "^3.3.2",
    "typescript": "~5.1.6"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@superset-ui/chart-controls": "^0.20.3",
    "@superset-ui/core": "^0.20.4",
    "json-bigint": "^1.0.0",
    "memoize-one": "^6.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-loadable": "^5.5.0",
    "recharts": "^2.15.4",
    "tinycolor2": "^1.6.0"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22"
  },
  "main": "babel.config.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cosmo-Tech/superset-viz-plugins.git"
  },
  "keywords": [
    "superset",
    "plugins",
    "charts"
  ],
  "author": "jreynard-code",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Cosmo-Tech/superset-viz-plugins/issues"
  },
  "homepage": "https://github.com/Cosmo-Tech/superset-viz-plugins#readme"
}
