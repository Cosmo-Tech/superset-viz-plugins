{
  "name": "cosmotech-viz-plugins",
  "version": "1.0.0",
  "description": "Monorepo de plugins de visualisation custom pour Apache Superset",
  "private": true,
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:dev": "lerna run build:dev",
    "clean": "lerna run clean",
    "test": "lerna run test",
    "test:watch": "lerna run test:watch",
    "lint": "lerna run lint",
    "lint:root": "eslint . --ext .ts,.tsx,.js --ignore-path .eslintignore",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^9.0.0",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@superset-ui/chart-controls": "^0.20.3",
    "@superset-ui/core": "^0.20.4",
    "json-bigint": "^1.0.0",
    "memoize-one": "^6.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-loadable": "^5.5.0",
    "recharts": "^2.15.4",
    "tinycolor2": "^1.6.0"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22"
  }
}
