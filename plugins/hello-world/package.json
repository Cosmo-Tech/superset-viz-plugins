{
  "name": "@cosmotech/plugin-hello-world",
  "version": "0.0.10",
  "description": "Simple Plugin that display \"Hello World\"",
  "pluginName": "HelloWorld",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "esm"
  ],
  "scripts": {
    "build": "babel src --extensions '.ts,.tsx' --copy-files --out-dir dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && cp -r src/images esm/images",
    "build:dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist esm coverage",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "author": "jreynard-code",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@superset-ui/chart-controls": "^0.20.3",
    "@superset-ui/core": "^0.20.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@superset-ui/chart-controls": "^0.20.3",
    "@superset-ui/core": "^0.20.4",
    "@types/jest": "^29.5.12",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cosmo-Tech/cosmotech-viz-plugins.git"
  },
  "keywords": [
    "superset",
    "chart",
    "demo",
    "hello-world"
  ],
  "bugs": {
    "url": "https://github.com/Cosmo-Tech/cosmotech-viz-plugins/issues"
  },
  "homepage": "https://github.com/Cosmo-Tech/cosmotech-viz-plugins#readme"
}
